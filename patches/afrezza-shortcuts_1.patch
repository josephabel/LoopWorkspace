+    // MARK: - Bolus reminder
+
+    /// Called once per loop cycle with Loop's current recommended manual bolus (units). Read-only:
+    /// this only decides whether to nudge the user; it never doses. All state is touched on main.
+    static func evaluateBolusReminder(recommendedAmount: Double) {
+        DispatchQueue.main.async {
+            let defaults = UserDefaults.standard
+            let enabled = (defaults.object(forKey: bolusReminderEnabledKey) as? Bool) ?? false
+            let threshold = (defaults.object(forKey: bolusReminderThresholdKey) as? Double) ?? 2.0
+
+            guard enabled else {
+                if bolusReminderEpisodeActive { clearBolusReminder() }
+                bolusReminderEpisodeActive = false
+                return
+            }
+
+            if recommendedAmount >= threshold {
+                // One nudge per episode; stay quiet while it remains high.
+                if !bolusReminderEpisodeActive {
+                    bolusReminderEpisodeActive = true
+                    fireBolusReminder(recommendedAmount: recommendedAmount)
+                }
+            } else {
+                // Recommendation dropped below threshold (e.g. user bolused) → reset the episode.
+                if bolusReminderEpisodeActive {
+                    bolusReminderEpisodeActive = false
+                    clearBolusReminder()
+                }
+            }
+        }
+    }
+
+    /// The user tapped or dismissed the bolus-reminder notification: cancel the pending escalation
+    /// alarm but leave the episode marked handled so it stays quiet until the recommendation resets.
+    static func acknowledgeBolusReminder() {
+        DispatchQueue.main.async {
+            cancelBolusEscalation()
+            UNUserNotificationCenter.current().removeDeliveredNotifications(withIdentifiers: [bolusReminderPrimaryID])
+        }
+    }
+
+    private static func fireBolusReminder(recommendedAmount: Double) {
+        let amountString = insulinReminderNumberFormatter.string(from: NSNumber(value: recommendedAmount)) ?? String(recommendedAmount)
+
+        let content = UNMutableNotificationContent()
+        content.title = NSLocalizedString("Bolus Suggested", comment: "Title for the bolus reminder notification")
+        content.body = String(format: NSLocalizedString("Loop is recommending about %@ U. Tap to review in Loop.", comment: "Body for the bolus reminder notification (1: units)"), amountString)
+        content.sound = .default
+        content.categoryIdentifier = bolusReminderCategoryIdentifier
+        if #available(iOS 15.0, *) { content.interruptionLevel = .timeSensitive }
+        UNUserNotificationCenter.current().add(UNNotificationRequest(identifier: bolusReminderPrimaryID, content: content, trigger: nil))
+
+        // Escalate to a full alarm in 10 minutes if the user hasn't acted.
+        let escalationDate = Date().addingTimeInterval(10 * 60)
+        let title = String(format: NSLocalizedString("Bolus Reminder: ~%@ U", comment: "Title for the bolus reminder escalation alarm (1: units)"), amountString)
+        #if canImport(AlarmKit)
+        if #available(iOS 26.0, *) {
+            let id = UUID()
+            bolusReminderAlarmID = id
+            scheduleBolusEscalationAlarm(id: id, at: escalationDate, title: title)
+            return
+        }
+        #endif
+        // Fallback (< iOS 26): a second time-sensitive notification.
+        let escalation = UNMutableNotificationContent()
+        escalation.title = NSLocalizedString("Bolus Reminder", comment: "Title for the bolus reminder escalation notification")
+        escalation.body = title
+        escalation.sound = .default
+        escalation.categoryIdentifier = bolusReminderCategoryIdentifier
+        if #available(iOS 15.0, *) { escalation.interruptionLevel = .timeSensitive }
+        let trigger = UNTimeIntervalNotificationTrigger(timeInterval: max(1, escalationDate.timeIntervalSinceNow), repeats: false)
+        UNUserNotificationCenter.current().add(UNNotificationRequest(identifier: bolusReminderEscalationID, content: escalation, trigger: trigger))
+    }
+
+    private static func cancelBolusEscalation() {
+        let center = UNUserNotificationCenter.current()
+        center.removePendingNotificationRequests(withIdentifiers: [bolusReminderEscalationID])
+        center.removeDeliveredNotifications(withIdentifiers: [bolusReminderEscalationID])
+        #if canImport(AlarmKit)
+        if #available(iOS 26.0, *), let id = bolusReminderAlarmID {
+            try? AlarmManager.shared.cancel(id: id)
+        }
+        #endif
+        bolusReminderAlarmID = nil
+    }
+
+    private static func clearBolusReminder() {
+        let center = UNUserNotificationCenter.current()
+        center.removePendingNotificationRequests(withIdentifiers: [bolusReminderPrimaryID, bolusReminderEscalationID])
+        center.removeDeliveredNotifications(withIdentifiers: [bolusReminderPrimaryID, bolusReminderEscalationID])
+        cancelBolusEscalation()
+    }

+        content.body = String(format: NSLocalizedString("An Afrezza dose (%@) was logged on the Bolus screen but never confirmed with Save. If you didn't take it, remove it from the Insulin Delivery list.", comment: "Body for the orphaned Afrezza flag notification (1: dose description)"), descriptions.joined(separator: ", "))

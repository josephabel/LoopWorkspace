+    /// Cancels every pending and delivered reminder that belongs to the same series as `request`.
+    static func cancelInsulinReminders(for request: UNNotificationRequest) {
+        guard let series = request.content.userInfo[insulinReminderSeriesKey] as? String else {
+            return
+        }
+        let center = UNUserNotificationCenter.current()
+        center.getPendingNotificationRequests { requests in
+            let ids = requests
+                .filter { ($0.content.userInfo[insulinReminderSeriesKey] as? String) == series }
+                .map { $0.identifier }
+            if !ids.isEmpty {
+                center.removePendingNotificationRequests(withIdentifiers: ids)
+            }
+        }
+        center.getDeliveredNotifications { notifications in
+            let ids = notifications
+                .filter { ($0.request.content.userInfo[insulinReminderSeriesKey] as? String) == series }
+                .map { $0.request.identifier }
+            if !ids.isEmpty {
+                center.removeDeliveredNotifications(withIdentifiers: ids)
+            }
+        }
+    }

+            scheduleInsulinAlarm(at: fireDate, units: units, insulinType: insulinType)
+            return
+        }
+        #endif
+        scheduleInsulinReminders(at: fireDate, units: units, insulinType: insulinType)
+    }
+
+    #if canImport(AlarmKit)

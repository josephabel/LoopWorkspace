+        let unitsString = insulinReminderNumberFormatter.string(from: NSNumber(value: units)) ?? String(units)
+        let typeString = insulinType?.title ?? NSLocalizedString("insulin", comment: "Generic insulin name used in the reminder when the type is unknown")
+        let alarmTitle = String(format: NSLocalizedString("Take %1$@ U of %2$@", comment: "Alarm title reminding the user to take a logged insulin dose (1: units, 2: insulin type)"), unitsString, typeString)
+
+        Task {
+            let manager = AlarmManager.shared
+            let authorized: Bool
+            switch manager.authorizationState {
+            case .authorized:
+                authorized = true
+            case .notDetermined:
+                authorized = ((try? await manager.requestAuthorization()) == .authorized)
+            default:
+                authorized = false
+            }
+            guard authorized else { return }
+
+            let alert = AlarmPresentation.Alert(
+                title: LocalizedStringResource(stringLiteral: alarmTitle),
+                stopButton: AlarmButton(
+                    text: "Taken",
+                    textColor: .white,
+                    systemImageName: "checkmark"

+    /// Schedules a series of time-sensitive reminders (default: every 2 minutes, up to 15 times)
+    /// starting at `fireDate`, to prompt the user to actually take a dose they logged ahead of time.
+    /// The series shares a random `series` id (in userInfo) so it can be cancelled as a group once
+    /// the user acts on any one of them (see `cancelInsulinReminders(for:)`).
+    static func scheduleInsulinReminders(at fireDate: Date,
+                                         units: Double,
+                                         insulinType: InsulinType?,
+                                         reminderCount: Int = 15,
+                                         interval: TimeInterval = 120) {
+        guard fireDate.timeIntervalSinceNow > 0 else { return }
+
+        let series = UUID().uuidString
+        let unitsString = insulinReminderNumberFormatter.string(from: NSNumber(value: units)) ?? String(units)
+        let typeString = insulinType?.title ?? NSLocalizedString("insulin", comment: "Generic insulin name used in the reminder when the type is unknown")
+
+        let center = UNUserNotificationCenter.current()
+        for index in 0..<max(1, reminderCount) {
+            let fireInterval = fireDate.timeIntervalSinceNow + interval * Double(index)
+            guard fireInterval > 0 else { continue }
+
+            let content = UNMutableNotificationContent()
+            content.title = NSLocalizedString("Take Your Insulin", comment: "Title for the insulin reminder notification")
+            content.body = String(format: NSLocalizedString("Reminder: take %1$@ U of %2$@ now. Swipe away or tap \"Taken ✓\" once you have.", comment: "Body for the insulin reminder notification (1: units, 2: insulin type)"), unitsString, typeString)
+            content.sound = .default
+            content.categoryIdentifier = insulinReminderCategoryIdentifier
+            content.userInfo = [insulinReminderSeriesKey: series]
+            if #available(iOS 15.0, *) {
+                content.interruptionLevel = .timeSensitive
+            }
+
+            let trigger = UNTimeIntervalNotificationTrigger(timeInterval: fireInterval, repeats: false)
+            let request = UNNotificationRequest(
+                identifier: "\(insulinReminderCategoryIdentifier).\(series).\(index)",
+                content: content,
+                trigger: trigger
+            )
+            center.add(request)
+        }
+    }
+
+    /// Cancels every pending and delivered reminder that belongs to the same series as `request`.
+    static func cancelInsulinReminders(for request: UNNotificationRequest) {
+        guard let series = request.content.userInfo[insulinReminderSeriesKey] as? String else {
+            return
+        }
+        let center = UNUserNotificationCenter.current()
+        center.getPendingNotificationRequests { requests in
+            let ids = requests
+                .filter { ($0.content.userInfo[insulinReminderSeriesKey] as? String) == series }
+                .map { $0.identifier }
+            if !ids.isEmpty {
+                center.removePendingNotificationRequests(withIdentifiers: ids)
+            }
+        }
+        center.getDeliveredNotifications { notifications in
+            let ids = notifications
+                .filter { ($0.request.content.userInfo[insulinReminderSeriesKey] as? String) == series }
+                .map { $0.request.identifier }
+            if !ids.isEmpty {
+                center.removeDeliveredNotifications(withIdentifiers: ids)
+            }
+        }
+    }
+
+    private static let insulinReminderNumberFormatter: NumberFormatter = {
+        let formatter = NumberFormatter()
+        formatter.numberStyle = .decimal
+        formatter.minimumFractionDigits = 0
+        formatter.maximumFractionDigits = 2
+        return formatter
+    }()
+
